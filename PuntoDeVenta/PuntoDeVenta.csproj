<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>assets\store.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="assets\store.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WinForms.DataVisualization" Version="1.10.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="FormDialogs\FormaPagoDialog.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="FormDialogs\ProductoBusquedaCategoriaDialog.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="FormDialogs\VentasEntradaSalidaDialog.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="FormDialogs\ProductoBusquedaDialog.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="FormDialogs\ProductoVerificadorDialog.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="FormDialogs\ProductoEtiquetaDialog.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="UserControls\ClientesControl.cs">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Compile>
    <Compile Update="UserControls\ProductosControls\CategoriaProductoControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="UserControls\ProductosControls\CatalogoProductosControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="UserControls\TurnosControls\ReporteTurnosControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="FormDialogs\FormaPagoDialog.resx">
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <EmbeddedResource Update="FormDialogs\NumberDialog.resx">
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <EmbeddedResource Update="FormDialogs\ClientesDialog.resx">
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <EmbeddedResource Update="FormDialogs\ProductoBusquedaCategoriaDialog.resx">
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <EmbeddedResource Update="FormDialogs\VentasEntradaSalidaDialog.resx">
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <EmbeddedResource Update="FormDialogs\ProductoBusquedaDialog.resx">
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <EmbeddedResource Update="FormDialogs\ProductoVerificadorDialog.resx">
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="assets\icons\info.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <None Update="assets\logo.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="assets\logo_bedaqui.jpg">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PuntoDeVenta.Application\PuntoDeVenta.Application.csproj" />
  </ItemGroup>

</Project>